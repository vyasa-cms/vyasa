{
  "$defs": {
    "ColorPalette": {
      "additionalProperties": false,
      "description": "The seven color roles Vyasa themes understand.\n\nDefaults form an accessible neutral palette with blue accent; every role\nships a dark variant so `[data-theme=dark]` works out of the box.",
      "properties": {
        "bg": {
          "$ref": "#/$defs/ColorSlot",
          "default": {
            "dark": "#101013",
            "light": "#ffffff"
          },
          "description": "Page background."
        },
        "border": {
          "$ref": "#/$defs/ColorSlot",
          "default": {
            "dark": "#27272a",
            "light": "#e4e4e7"
          },
          "description": "Hairlines and separators."
        },
        "on_primary": {
          "$ref": "#/$defs/ColorSlot",
          "default": {
            "dark": "#0b1220",
            "light": "#ffffff"
          },
          "description": "Text placed on top of `primary`."
        },
        "primary": {
          "$ref": "#/$defs/ColorSlot",
          "default": {
            "dark": "#60a5fa",
            "light": "#2563eb"
          },
          "description": "Brand / accent color."
        },
        "surface": {
          "$ref": "#/$defs/ColorSlot",
          "default": {
            "dark": "#1b1b1f",
            "light": "#f4f4f5"
          },
          "description": "Cards and raised panels."
        },
        "text": {
          "$ref": "#/$defs/ColorSlot",
          "default": {
            "dark": "#f4f4f5",
            "light": "#18181b"
          },
          "description": "Primary text color."
        },
        "text_muted": {
          "$ref": "#/$defs/ColorSlot",
          "default": {
            "dark": "#a1a1aa",
            "light": "#52525b"
          },
          "description": "Secondary text color."
        }
      },
      "type": "object"
    },
    "ColorSlot": {
      "additionalProperties": false,
      "description": "One color role with its light value and optional dark override.",
      "properties": {
        "dark": {
          "anyOf": [
            {
              "$ref": "#/$defs/HexColor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Value used in dark contexts; `None` keeps the light value."
        },
        "light": {
          "$ref": "#/$defs/HexColor",
          "description": "Value used in the light palette (`:root`)."
        }
      },
      "required": [
        "light"
      ],
      "type": "object"
    },
    "Density": {
      "description": "UI whitespace density.",
      "oneOf": [
        {
          "const": "compact",
          "description": "Tighter paddings (`×0.85`).",
          "type": "string"
        },
        {
          "const": "comfortable",
          "description": "Default rhythm (`×1`).",
          "type": "string"
        },
        {
          "const": "spacious",
          "description": "Airy paddings (`×1.25`).",
          "type": "string"
        }
      ]
    },
    "Direction": {
      "description": "Site-wide text direction.",
      "oneOf": [
        {
          "const": "ltr",
          "description": "Left-to-right (default).",
          "type": "string"
        },
        {
          "const": "rtl",
          "description": "Right-to-left; flips the layout engine's logical properties.",
          "type": "string"
        }
      ]
    },
    "FontChoice": {
      "description": "A font selection: a built-in system-safe stack or a custom family name.\n\nCustom families should be backed by an entry in\n[`Typography::font_faces`] when they are web fonts; system generics fall\nback gracefully in every browser.",
      "oneOf": [
        {
          "const": "system_ui",
          "description": "`system-ui` stack (default; always available offline).",
          "type": "string"
        },
        {
          "const": "serif",
          "description": "Classic serif stack.",
          "type": "string"
        },
        {
          "const": "mono",
          "description": "Monospace stack for code-heavy themes.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A custom family name (e.g. `\"Inter\"`), optionally served via\n`@font-face`.",
          "properties": {
            "custom": {
              "type": "string"
            }
          },
          "required": [
            "custom"
          ],
          "type": "object"
        }
      ]
    },
    "FontFace": {
      "additionalProperties": false,
      "description": "One `@font-face` declaration.",
      "properties": {
        "family": {
          "description": "Family name this face registers; must match a\n[`FontChoice::Custom`] usage to have any effect.",
          "type": "string"
        },
        "src": {
          "description": "Web font source; `https://` or a bundled `/theme-assets/fonts/` path, so themes can never\ninject insecure or `javascript:` URLs into rendered pages.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "family"
      ],
      "type": "object"
    },
    "HexColor": {
      "description": "RGB hex color, `#rgb` or `#rrggbb`.",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "type": "string"
    },
    "LayoutMetrics": {
      "additionalProperties": false,
      "description": "Layout metric tokens: content column width, sidebar width, and UI density.",
      "properties": {
        "breakpoint_md_px": {
          "default": 900.0,
          "description": "Width below which the sidebar drops under the content, in px.",
          "format": "float",
          "type": "number"
        },
        "breakpoint_sm_px": {
          "default": 640.0,
          "description": "Width below which columns collapse and type steps down, in px.\n\nA breakpoint is a theme decision like any other metric, but CSS\nmedia queries cannot read custom properties, so these are\ninterpolated into the generated stylesheets rather than emitted as\nvariables. They were two magic numbers in the stylesheet source\nuntil they were named here.",
          "format": "float",
          "type": "number"
        },
        "content_width_px": {
          "default": 960.0,
          "description": "Main content column width in px.",
          "format": "float",
          "type": "number"
        },
        "density": {
          "$ref": "#/$defs/Density",
          "default": "comfortable",
          "description": "Whitespace density preset for lists and cards."
        },
        "sidebar_width_px": {
          "default": 260.0,
          "description": "Sidebar column width in px (0 disables the sidebar slot).",
          "format": "float",
          "type": "number"
        }
      },
      "type": "object"
    },
    "ScaleRatio": {
      "description": "Modular scale ratios with well-known names plus a numeric escape hatch.",
      "oneOf": [
        {
          "const": "major_second",
          "description": "1.125",
          "type": "string"
        },
        {
          "const": "minor_third",
          "description": "1.2",
          "type": "string"
        },
        {
          "const": "major_third",
          "description": "1.25",
          "type": "string"
        },
        {
          "const": "perfect_fourth",
          "description": "1.333…",
          "type": "string"
        },
        {
          "const": "golden",
          "description": "1.618…",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Any ratio in `[1.0, 2.5]`.",
          "properties": {
            "custom": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "custom"
          ],
          "type": "object"
        }
      ]
    },
    "ShadowLevel": {
      "description": "Box-shadow elevation presets.",
      "oneOf": [
        {
          "const": "none",
          "description": "No shadow at all.",
          "type": "string"
        },
        {
          "const": "small",
          "description": "Subtle card lift.",
          "type": "string"
        },
        {
          "const": "medium",
          "description": "Standard dropdown / card shadow.",
          "type": "string"
        },
        {
          "const": "large",
          "description": "Modal / popover shadow.",
          "type": "string"
        }
      ]
    },
    "Spacing": {
      "additionalProperties": false,
      "description": "Spacing tokens: the base unit and the vertical rhythm multipliers.",
      "properties": {
        "section_scale": {
          "default": [
            1.0,
            2.0,
            4.0,
            8.0
          ],
          "description": "Ascending section-padding multipliers of [`Spacing::unit_px`].",
          "items": {
            "format": "float",
            "type": "number"
          },
          "type": "array"
        },
        "unit_px": {
          "default": 4.0,
          "description": "Base spacing unit in px; utilities use multiples of it.",
          "format": "float",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Typography": {
      "additionalProperties": false,
      "description": "Typography tokens: font stacks, base size, and the modular-scale ratio.",
      "properties": {
        "base_size_px": {
          "default": 16.0,
          "description": "Base font size in px (headings scale from this).",
          "format": "float",
          "type": "number"
        },
        "body": {
          "$ref": "#/$defs/FontChoice",
          "default": "system_ui",
          "description": "Body font."
        },
        "font_faces": {
          "default": [],
          "description": "`@font-face` declarations backing [`FontChoice::Custom`] families.",
          "items": {
            "$ref": "#/$defs/FontFace"
          },
          "type": "array"
        },
        "heading": {
          "$ref": "#/$defs/FontChoice",
          "default": "system_ui",
          "description": "Heading font."
        },
        "scale_ratio": {
          "$ref": "#/$defs/ScaleRatio",
          "default": "major_third",
          "description": "Named or numeric type-scale ratio."
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Vyasa design-token schema v1.",
  "properties": {
    "colors": {
      "$ref": "#/$defs/ColorPalette",
      "default": {
        "bg": {
          "dark": "#101013",
          "light": "#ffffff"
        },
        "border": {
          "dark": "#27272a",
          "light": "#e4e4e7"
        },
        "on_primary": {
          "dark": "#0b1220",
          "light": "#ffffff"
        },
        "primary": {
          "dark": "#60a5fa",
          "light": "#2563eb"
        },
        "surface": {
          "dark": "#1b1b1f",
          "light": "#f4f4f5"
        },
        "text": {
          "dark": "#f4f4f5",
          "light": "#18181b"
        },
        "text_muted": {
          "dark": "#a1a1aa",
          "light": "#52525b"
        }
      },
      "description": "Light/dark color roles."
    },
    "direction": {
      "$ref": "#/$defs/Direction",
      "default": "ltr",
      "description": "Text direction for the whole site."
    },
    "layout": {
      "$ref": "#/$defs/LayoutMetrics",
      "default": {
        "breakpoint_md_px": 900.0,
        "breakpoint_sm_px": 640.0,
        "content_width_px": 960.0,
        "density": "comfortable",
        "sidebar_width_px": 260.0
      },
      "description": "Layout metrics (content column, sidebar, density)."
    },
    "radius_px": {
      "default": 8.0,
      "description": "Global corner radius in px.",
      "format": "float",
      "type": "number"
    },
    "shadow": {
      "$ref": "#/$defs/ShadowLevel",
      "default": "small",
      "description": "Elevation preset for cards and overlays."
    },
    "spacing": {
      "$ref": "#/$defs/Spacing",
      "default": {
        "section_scale": [
          1.0,
          2.0,
          4.0,
          8.0
        ],
        "unit_px": 4.0
      },
      "description": "Spacing unit and section rhythm multipliers."
    },
    "typography": {
      "$ref": "#/$defs/Typography",
      "default": {
        "base_size_px": 16.0,
        "body": "system_ui",
        "font_faces": [],
        "heading": "system_ui",
        "scale_ratio": "major_third"
      },
      "description": "Font choices, base size, and type-scale ratio."
    },
    "version": {
      "default": 1,
      "description": "Schema version; must equal [`TOKEN_SCHEMA_VERSION`].",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "TokenSet",
  "type": "object"
}
