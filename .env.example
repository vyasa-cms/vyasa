# Vyasa configuration, copy to .env and adjust.
# Every value can also live in vyasa.toml; env wins.

# Required: PostgreSQL connection string. A platform's DATABASE_URL is
# used when this is unset.
VYASA_DATABASE_URL=postgres://vyasa:vyasa@localhost:5432/vyasa

# HTTP listen address (default 0.0.0.0:3000). A platform's PORT is used
# when this is unset (binds 0.0.0.0:$PORT).
#VYASA_BIND_ADDR=0.0.0.0:3000

# Where the server keeps its own small files: the setup token, update
# staging (default .run; the container image sets /tmp/vyasa-run).
#VYASA_RUN_DIR=.run

# Logging: level and format (pretty|json).
#VYASA_LOG__LEVEL=info
#VYASA_LOG__FORMAT=pretty

# Database pool (defaults shown).
#VYASA_DB__MAX_CONNECTIONS=10
#VYASA_DB__ACQUIRE_TIMEOUT_SECS=5

# Long-lived server secret. Signs preview/private-post links so they
# survive a restart, and encrypts the AI provider keys registered on the
# admin's Models page. Generate one with: openssl rand -hex 32
#VYASA_SECRET_KEY=

# Behind a reverse proxy: peers whose X-Forwarded-For is believed
# (addresses or CIDR blocks). A Cloudflare tunnel also wants the second line.
#VYASA_TRUSTED_PROXIES=127.0.0.1,::1
#VYASA_TRUST_CF_CONNECTING_IP=true

# Cloud AI providers. Register providers and models on the admin's Models
# page instead; these env vars remain as a fallback for the text model.
#VYASA_AI__ANTHROPIC_KEY=
#VYASA_AI__OPENAI_KEY=
#VYASA_AI__MONTHLY_BUDGET_USD=25

# Outbound email. With no relay configured Vyasa logs messages instead of
# sending them, which is the intended default for development: password
# reset links and comment notices appear in the log, not in an inbox.
#VYASA_SMTP__HOST=smtp.example.com
#VYASA_SMTP__PORT=587
#VYASA_SMTP__USERNAME=
#VYASA_SMTP__PASSWORD=
#VYASA_SMTP__FROM=vyasa@example.com

# Test-only: throwaway database for env-gated integration tests.
#VYASA_TEST_DATABASE_URL=postgres://vyasa:vyasa@127.0.0.1:55433/vyasa_test   # scripts/test-with-db.sh's Postgres; never the production server
