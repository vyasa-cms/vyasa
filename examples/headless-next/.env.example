# The Vyasa instance to read from.
VYASA_URL=http://localhost:3000

# A key minted at Settings → API keys, or via:
#   curl -X POST $VYASA_URL/api/v1/api-keys \
#     -H 'content-type: application/json' \
#     -b "vy_session=$SESSION" \
#     -d '{"name":"next frontend","capabilities":["edit_posts"]}'
#
# Optional: published content is readable without a key. Set one only if the
# frontend needs drafts or previews.
#VYASA_API_KEY=vy_...

# Secret of a Vyasa webhook pointed at POST /api/revalidate, subscribed to
# post.published, post.updated and post.trashed. Without it the revalidation
# route fails closed (503) rather than accepting unsigned requests.
#VYASA_WEBHOOK_SECRET=whsec_...
