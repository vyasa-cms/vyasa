{
  "name": "vyasa-website",
  "private": true,
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "prepare:content": "pnpm sync:docs && pnpm gen:api",
    "dev": "pnpm prepare:content && next dev",
    "build": "pnpm prepare:content && next build",
    "start": "serve out",
    "types:check": "pnpm prepare:content && next typegen && tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "cn": "^0.3.0",
    "fumadocs-core": "16.15.17",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-openapi": "12.1.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.17",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
