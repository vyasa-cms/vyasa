/* Vyasa design tokens — generated; do not edit. */
:root {
  color-scheme: light;
  --vy-color-bg: #fdfdfb;
  --vy-color-surface: #ffffff;
  --vy-color-text: #1a1a1a;
  --vy-color-text-muted: #616161;
  --vy-color-border: #e0e0e0;
  --vy-color-primary: #0f766e;
  --vy-color-on-primary: #ffffff;
  --vy-radius: 12px;
  --vy-shadow: 0 2px 8px rgb(0 0 0 / 0.08);
  --vy-space-unit: 5px;
  --vy-section-scale:1 2 3 5 8;
  --vy-content-width: 1100px;
  --vy-sidebar-width: 280px;
  --vy-density: 1.25;
  --vy-direction: ltr;
  direction: ltr;
  --vy-base-size: 17px;
  --vy-scale-ratio: 1.3333333333333333;
  --vy-font-heading: "Inter", system-ui, sans-serif;
  --vy-font-body: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
}
@media (prefers-color-scheme: dark) {
:root:not([data-theme="light"]) {
  --vy-color-bg: #121212;
  --vy-color-surface: #1e1e1e;
  --vy-color-text: #eeeeee;
  --vy-color-text-muted: #9e9e9e;
  --vy-color-border: #333333;
  --vy-color-primary: #2dd4bf;
  --vy-color-on-primary: #04211d;
  color-scheme: dark;
}
}
[data-theme="dark"] {
  --vy-color-bg: #121212;
  --vy-color-surface: #1e1e1e;
  --vy-color-text: #eeeeee;
  --vy-color-text-muted: #9e9e9e;
  --vy-color-border: #333333;
  --vy-color-primary: #2dd4bf;
  --vy-color-on-primary: #04211d;
  color-scheme: dark;
}
@font-face {
  font-family: "Inter";
  src: url("https://fonts.example.com/inter.woff2") format("woff2");
}
