{% extends "base.html" %}
{% block body %}
{% if sections %}{{ sections | safe }}{% else %}
<article class="vy-single blog-single">
  <header class="blog-single__header">
    <h1 class="vy-title">{{ page.post_title }}</h1>
    <p class="vy-meta">{{ page.post_author | default(value="") }} · {{ page.post_date | default(value="") }}</p>
  </header>
  {{ regions.body | safe }}
  {{ regions.comments | default(value="") | safe }}
</article>
{% endif %}
{% endblock %}
